// -*- mode:c++ -*-

////////////////////////////////////////////////////////////////////
//
// Custom Indirect Load/Store Instructions
//
////////////////////////////////////////////////////////////////////

def template IndirectRegDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst,
                       uint32_t _dest, uint32_t _src_alias,
                       uint32_t _base_data, uint32_t _base_index,
                       uint32_t _index_reg);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

      protected:
        RegIndex src_alias;
        RegIndex base_index;
        uint64_t shiftAmtIndex;
    };
}};

def template IndirectRegConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            uint32_t _dest, uint32_t _src_alias,
            uint32_t _base_data, uint32_t _base_index,
            uint32_t _index_reg) :
         %(base_class)s("%(mnemonic)s", machInst, %(op_class)s,
                 (RegIndex)_dest, (RegIndex)_base_data,
                 (RegIndex)_index_reg,
                 ArmISA::UXTX, %(shift_amt)d),
         src_alias((RegIndex)_src_alias),
         base_index((RegIndex)_base_index),
         shiftAmtIndex(%(shift_amt_index)d)
    {
        // Constructor
        %(constructor)s;
    }
}};

let {{
    import math

    # -------------------------------------------------------------------------
    # Python Classes
    # -------------------------------------------------------------------------

    class CustomLoadStore(LoadStoreInst):
        def __init__(self, mnem, size_data, size_index, flavor):
            # Ensure decConstBase is set if not already set by subclass ref
            if not hasattr(self, 'decConstBase'):
                 self.decConstBase = 'MemoryOffset'

            # Ensure execBase is set for eval()
            # It is set by subclasses (LoadIndirect -> execBase='Load')

            super().__init__()
            self.name = mnem
            self.size_data = size_data
            self.size_index = size_index
            self.flavor = flavor
            self.post = False
            self.add = True
            self.writeback = False
            self.sign = False
            self.user = False
            self.rasPop = False
            # MemFlags usually only track the DATA access alignment
            self.memFlags = ["%d" % int(math.log(self.size_data, 2)), "ArmISA::MMU::AllowUnaligned"]
            self.instFlags = []
            # AArch64 instructions are conventionally unconditional
            self.codeBlobs = {"postacc_code" : "", "predicate_test" : "true"}

        # Copied from LoadInst64 in ldr64.isa
        def emitHelper(self, base='Memory64', wbDecl=None):
            global header_output, decoder_output, exec_output

            # Simplified for skeleton: always assume normal
            fa_code = None

            (newHeader, newDecoder, newExec) = \
                self.fillTemplates(self.name, self.Name, self.codeBlobs,
                                   self.memFlags, self.instFlags,
                                   base, wbDecl, faCode=fa_code)

            header_output += newHeader
            decoder_output += newDecoder
            exec_output += newExec


    class LoadIndirectBase(CustomLoadStore):
        def emit(self):
            # We emit using 'ArmISA::MemoryReg64' as the base class in Python,
            # but the C++ class generated by IndirectRegDeclare will inherit from it
            # and satisfy the constructor requirements.
            self.emitHelper('ArmISA::MemoryReg64', None)

    # -------------------------------------------------------------------------
    # Integer Load Indirect (ldind)
    # -------------------------------------------------------------------------
    class LoadIndirect(LoadIndirectBase):
        execBase = 'Load'
        decConstBase = 'IndirectReg'
        def __init__(self, mnem, size_data, size_index):
            super().__init__(mnem, size_data, size_index, 'normal')

            # Suffix: e.g. ldindw_x
            s_data_str = "b" if size_data==1 else "h" if size_data==2 else "w" if size_data==4 else "x"
            s_idx_str = "w" if size_index==4 else "x"

            self.Name = "LDIND" + s_data_str.upper() + "_" + s_idx_str.upper()

            # Data Access Size
            memacc = "Dest = Mem_ud;" # Default
            if size_data == 1:
                memacc = "Dest = Mem_ub;"
            elif size_data == 2:
                memacc = "Dest = Mem_uh;"
            elif size_data == 4:
                memacc = "Dest = Mem_uw;"
            else:
                memacc = "Dest = Mem_ud;"

            shift_idx = 2 if size_index==4 else 3
            shift_data = 0 if size_data==1 else 1 if size_data==2 else 2 if size_data==4 else 3

            # EA Code:
            # We use base class members:
            #   base (mapped from DataBase/Rn)
            #   offset (mapped from Index/Ra)
            #   shiftAmt (mapped from shift_data)
            #
            # The simplified EA calculation for now (as a placeholder):
            self.codeBlobs["ea_code"] = "EA = base + (offset << shiftAmt);"

            self.codeBlobs["memacc_code"] = memacc
            self.codeBlobs["shift_amt"] = shift_data
            self.codeBlobs["shift_amt_index"] = shift_idx


    # -------------------------------------------------------------------------
    # Integer Store Indirect (stind)
    # -------------------------------------------------------------------------
    class StoreIndirect(LoadIndirectBase):
        execBase = 'Store'
        decConstBase = 'IndirectReg'
        def __init__(self, mnem, size_data, size_index):
            super().__init__(mnem, size_data, size_index, 'normal')

            s_data_str = "b" if size_data==1 else "h" if size_data==2 else "w" if size_data==4 else "x"
            s_idx_str = "w" if size_index==4 else "x"
            self.Name = "STIND" + s_data_str.upper() + "_" + s_idx_str.upper()

            # Store Access
            memacc = "Mem_ud = Dest;"
            if size_data == 1:
                memacc = "Mem_ub = Dest;"
            elif size_data == 2:
                memacc = "Mem_uh = Dest;"
            elif size_data == 4:
                memacc = "Mem_uw = Dest;"
            else:
                memacc = "Mem_ud = Dest;"

            shift_data = 0 if size_data==1 else 1 if size_data==2 else 2 if size_data==4 else 3

            self.codeBlobs["ea_code"] = "EA = base + (offset << shiftAmt);"
            self.codeBlobs["memacc_code"] = memacc
            self.codeBlobs["shift_amt"] = shift_data
            self.codeBlobs["shift_amt_index"] = 2 if size_index==4 else 3


    def buildIndirect(mnem_ld, mnem_st):
        # Generate 8 variants for Load
        for s_data in [1, 2, 4, 8]:
            for s_idx in [4, 8]:
                suffix = "b" if s_data==1 else "h" if s_data==2 else "w" if s_data==4 else "x"
                suffix += "_" + ("w" if s_idx==4 else "x")
                LoadIndirect(mnem_ld + suffix, s_data, s_idx).emit()

        # Generate 8 variants for Store
        for s_data in [1, 2, 4, 8]:
            for s_idx in [4, 8]:
                suffix = "b" if s_data==1 else "h" if s_data==2 else "w" if s_data==4 else "x"
                suffix += "_" + ("w" if s_idx==4 else "x")
                StoreIndirect(mnem_st + suffix, s_data, s_idx).emit()

    buildIndirect("ldind", "stind")
}};
