// -*- mode:c++ -*-

////////////////////////////////////////////////////////////////////
//
// Custom Indirect Load/Store Instructions
//
////////////////////////////////////////////////////////////////////

// ---------------------------------------------------------------------------
// Declaration template (header output)
// ---------------------------------------------------------------------------
def template IndirectRegDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     */
    class %(class_name)s : public %(base_class)s
    {
      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst,
                       uint32_t _dest, uint32_t _src_alias,
                       uint32_t _base_data, uint32_t _base_index,
                       uint32_t _index_reg);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

      protected:
        RegId customSrcRegIdxArr[4];
        RegId customDestRegIdxArr[2];

        uint32_t operand_idx_base_data;
        uint32_t operand_idx_base_index;
        uint32_t operand_idx_index_reg;
        uint32_t operand_idx_src_alias;
        uint32_t operand_idx_dest_src_alias;
        uint64_t shiftAmtIndex;
    };
}};

def template IndirectRegConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            uint32_t _dest, uint32_t _src_alias,
            uint32_t _base_data, uint32_t _base_index,
            uint32_t _index_reg) :
         %(base_class)s("%(mnemonic)s", machInst, %(op_class)s,
                 (RegIndex)_dest, (RegIndex)_base_index,
                 ArmISA::UXTX, %(shift_amt)d),
         shiftAmtIndex(%(shift_amt_index)d)
    {
        setRegIdxArrays(
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::customSrcRegIdxArr),
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::customDestRegIdxArr));

        %(constructor)s;

        operand_idx_base_data = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_data, intRegClass[_base_data]);

        operand_idx_base_index = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_index, intRegClass[_base_index]);

        operand_idx_index_reg = _numSrcRegs++;
        setSrcRegIdx(operand_idx_index_reg, intRegClass[_index_reg]);

        operand_idx_src_alias = _numSrcRegs++;
        setSrcRegIdx(operand_idx_src_alias, intRegClass[_src_alias]);

        operand_idx_dest_src_alias = _numDestRegs++;
        setDestRegIdx(operand_idx_dest_src_alias, intRegClass[_src_alias]);
    }
}};



let {{
    import math

    # -------------------------------------------------------------------------

    # -------------------------------------------------------------------------
    # Python Classes
    # -------------------------------------------------------------------------

    class LoadIndirect:
        """
        Generates one LDIND variant using the LoadIndirect{Declare,Constructor,
        InitiateAcc,CompleteAcc,Execute} templates.

        size_data  – bytes of one data element  (e.g. 8 for ldindX_*)
        size_index – bytes of one index element (e.g. 4 for ldind*_w)

        The two sizes are passed directly to the MemoryInd64 constructor as
        plain integers; no Mem type coupling occurs here.
        """
        execBase   = 'LoadIndirect'
        decConstBase = 'LoadIndirect'

        def __init__(self, mnem, size_data, size_index):
            self.name       = mnem
            self.size_data  = size_data
            self.size_index = size_index

            s_data_str = ("b" if size_data  == 1 else
                          "h" if size_data  == 2 else
                          "w" if size_data  == 4 else "x")
            s_idx_str  = "w" if size_index == 4 else "x"

            self.Name = "LDIND" + s_data_str.upper() + "_" + s_idx_str.upper()

        def emit(self):
            global header_output, decoder_output, exec_output

            iop = ArmInstObjParams(
                self.name,
                self.Name,
                "ArmISA::MemoryInd64",
                {
                    "size_index" : self.size_index,
                    "size_data"  : self.size_data,
                    # Legacy placeholders – no longer used for Mem sizing
                    "shift_amt"       : int(math.log2(self.size_data)),
                    "shift_amt_index" : int(math.log2(self.size_index)),
                    # Satisfy fillTemplates stubs
                    "ea_code"         : "",
                    "memacc_code"     : ";",
                    "postacc_code"    : "",
                    "predicate_test"  : "true",
                    "fa_code"         : "",
                    "acc_name"        : self.Name,
                    "use_uops"        : 0,
                    "use_wb"          : 0,
                    "use_pc"          : 0,
                    "wb_decl"         : None,
                    "pc_decl"         : None,
                    "is_ras_pop"      : "0",
                },
                ['IsLoad']
            )

            header_output  += LoadIndirectDeclare.subst(iop)
            decoder_output += LoadIndirectConstructor.subst(iop)
            exec_output    += (LoadIndirectExecute.subst(iop) +
                               LoadIndirectInitiateAcc.subst(iop) +
                               LoadIndirectCompleteAcc.subst(iop))

    class StoreIndirect:
        execBase   = 'StoreIndirect'
        decConstBase = 'StoreIndirect'

        def __init__(self, mnem, size_data, size_index):
            self.name       = mnem
            self.size_data  = size_data
            self.size_index = size_index

            s_data_str = ("b" if size_data  == 1 else
                          "h" if size_data  == 2 else
                          "w" if size_data  == 4 else "x")
            s_idx_str  = "w" if size_index == 4 else "x"

            self.Name = "STIND" + s_data_str.upper() + "_" + s_idx_str.upper()

        def emit(self):
            global header_output, decoder_output, exec_output

            iop = ArmInstObjParams(
                self.name,
                self.Name,
                "ArmISA::MemoryInd64",
                {
                    "size_index" : self.size_index,
                    "size_data"  : self.size_data,
                    "shift_amt"       : int(math.log2(self.size_data)),
                    "shift_amt_index" : int(math.log2(self.size_index)),
                    "ea_code"         : "",
                    "memacc_code"     : ";",
                    "postacc_code"    : "",
                    "predicate_test"  : "true",
                    "fa_code"         : "",
                    "acc_name"        : self.Name,
                    "use_uops"        : 0,
                    "use_wb"          : 0,
                    "use_pc"          : 0,
                    "wb_decl"         : None,
                    "pc_decl"         : None,
                    "is_ras_pop"      : "0",
                },
                ['IsStore']
            )

            header_output  += StoreIndirectDeclare.subst(iop)
            decoder_output += StoreIndirectConstructor.subst(iop)
            exec_output    += (StoreIndirectExecute.subst(iop) +
                               StoreIndirectInitiateAcc.subst(iop) +
                               StoreIndirectCompleteAcc.subst(iop))

    def buildIndirect(mnem_ld):
        # Generate variants for Load: data sizes 1/2/4/8 × index sizes 4/8
        for s_data in [1, 2, 4, 8]:
            for s_idx in [4, 8]:
                s_d_str = ("b" if s_data == 1 else
                           "h" if s_data == 2 else
                           "w" if s_data == 4 else "x")
                s_i_str = "w" if s_idx == 4 else "x"
                LoadIndirect(mnem_ld + s_d_str + "_" + s_i_str, s_data, s_idx).emit()

    buildIndirect("ldind")
}};

// ---------------------------------------------------------------------------
// Stub classes for decoder completeness
//
// The decoder references all 16 LDIND and 8 STIND variants.  The ones below
// are not yet implemented; they panic if actually executed.  This satisfies
// the linker without dead-coding the decoder.
// ---------------------------------------------------------------------------
def template IndirectStubDeclare {{
    class %(class_name)s : public ArmISA::MemoryInd64
    {
      public:
        %(class_name)s(ExtMachInst machInst,
                       uint32_t _dest, uint32_t _src_alias,
                       uint32_t _base_data, uint32_t _base_index,
                       uint32_t _index_reg);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;
    };
}};

def template IndirectStubConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            uint32_t _dest, uint32_t _src_alias,
            uint32_t _base_data, uint32_t _base_index,
            uint32_t _index_reg) :
         ArmISA::MemoryInd64("%(mnemonic)s", machInst, %(op_class)s,
                 (RegIndex)_dest, (RegIndex)_base_index,
                 %(size_index)d, %(size_data)d)
    {}
}};

def template IndirectStubExecute {{
    Fault %(class_name)s::execute(ExecContext *xc,
            trace::InstRecord *) const {
        panic("%(mnemonic)s: not implemented");
    }
    Fault %(class_name)s::initiateAcc(ExecContext *xc,
            trace::InstRecord *) const {
        panic("%(mnemonic)s: not implemented");
    }
    Fault %(class_name)s::completeAcc(PacketPtr, ExecContext *xc,
            trace::InstRecord *) const {
        panic("%(mnemonic)s: not implemented");
    }
}};

let {{
    import math

    class IndirectStub:
        """Emit a stub class that panics on execution."""
        decConstBase = 'IndirectStub'

        def __init__(self, mnem, name, size_data, size_index):
            self.name       = mnem
            self.Name       = name
            self.size_data  = size_data
            self.size_index = size_index

        def emit(self):
            global header_output, decoder_output, exec_output
            iop = ArmInstObjParams(
                self.name, self.Name, "ArmISA::MemoryInd64",
                {
                    "size_index"     : self.size_index,
                    "size_data"      : self.size_data,
                    "shift_amt"      : int(math.log2(self.size_data)),
                    "shift_amt_index": int(math.log2(self.size_index)),
                    "ea_code"        : "",
                    "memacc_code"    : ";",
                    "postacc_code"   : "",
                    "predicate_test" : "true",
                    "fa_code"        : "",
                    "acc_name"       : self.Name,
                    "use_uops"       : 0, "use_wb": 0, "use_pc": 0,
                    "wb_decl"        : None, "pc_decl": None,
                    "is_ras_pop"     : "0",
                }, [])
            header_output  += IndirectStubDeclare.subst(iop)
            decoder_output += IndirectStubConstructor.subst(iop)
            exec_output    += IndirectStubExecute.subst(iop)

    # All STIND variants (stores)
    def buildIndirectStore(mnem_st):
        for s_data in [1, 2, 4, 8]:
            for s_idx in [4, 8]:
                s_d_str = ("b" if s_data == 1 else
                           "h" if s_data == 2 else
                           "w" if s_data == 4 else "x")
                s_i_str = "w" if s_idx == 4 else "x"
                StoreIndirect(mnem_st + s_d_str + "_" + s_i_str, s_data, s_idx).emit()

    buildIndirectStore("stind")
}};
