// Atomic operations in memory

def template AmoOpExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
                            trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;
        %(ea_code)s;

        %(usrDecl)s;

        %(memacc_code)s;

        %(amo_code)s;
        assert(amo_op);

        const Fault fault = amoMemAtomicLE(xc, traceData, Mem, EA,
                                           memAccessFlags, amo_op);

        if (fault == NoFault) {
            %(postacc_code)s;
            %(op_wb)s;
        }

        return fault;
    }
}};

def template AmoOpInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_src_decl)s;
        %(op_rd)s;
        %(ea_code)s;
        %(usrDecl)s;

        %(memacc_code)s;

        %(amo_code)s;

        assert(amo_op);
        return initiateMemAMO(xc, traceData, EA, Mem, memAccessFlags,
                              amo_op);
     }
}};

def template AmoOpCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

         // ARM instructions will not have a pkt if the predicate is false
        getMemLE(pkt, Mem, traceData);

        %(postacc_code)s;

        %(op_wb)s;

        return NoFault;
    }

}};

def template AmoOpDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        /// Constructor.
        %(class_name)s(ExtMachInst machInst, RegIndex _dest,
                       RegIndex _base, RegIndex _result);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

        void
        annotateFault(ArmISA::ArmFault *fault) override
        {
            %(fa_code)s
        }
    };
}};


def template AmoOpConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            RegIndex _dest, RegIndex _base, RegIndex _result) :
         %(base_class)s("%(mnemonic)s", machInst, %(op_class)s,
                        _dest, _base, _result)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        flags[IsStore] = false;
        flags[IsLoad] = false;
    }
}};

def template AmoArithmeticOpDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        bool isXZR ;
        /// Constructor.
        %(class_name)s(ExtMachInst machInst, RegIndex _dest,
                       RegIndex _base, RegIndex _result);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

        void
        annotateFault(ArmISA::ArmFault *fault) override
        {
            %(fa_code)s
        }
    };
}};

def template AmoArithmeticOpConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            RegIndex _dest, RegIndex _base, RegIndex _result) :
         %(base_class)s("%(mnemonic)s", machInst, %(op_class)s,
                          _dest,  _base, _result)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        isXZR = false;
        uint32_t r2 = dest;
        flags[IsStore] = false;
        flags[IsLoad] = false;
        if (r2 == 31) {
            isXZR = true;
        }
    }
}};

// ---------------------------------------------------------------------------
// Indirect Load (LDIND) templates
//
// These templates implement the two-phase indirect load instruction family.
// Phase 1: fetch the index element from the index array (size = sizeIndex).
// Phase 2: generated by Ruby via getDependentReq(); response carries
//          IndirectResponseExt with the resolved index value.
// ---------------------------------------------------------------------------

def template LoadIndirectDeclare {{
    /**
     * Static instruction class for "%(mnemonic)s".
     * Inherits from MemoryInd64 which carries sizeIndex and sizeData
     * as independent members, decoupled from any single Mem type.
     */
    class %(class_name)s : public ArmISA::MemoryInd64
    {
      public:
        %(class_name)s(ExtMachInst machInst,
                       uint32_t _dest, uint32_t _src_alias,
                       uint32_t _base_data, uint32_t _base_index,
                       uint32_t _index_reg);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

      protected:
        RegId customSrcRegIdxArr[4];
        RegId customDestRegIdxArr[3]; // [0]=dest, [1]=alidas, [2..] reserve

        uint32_t operand_idx_dest;           // Phase 2 data written here
        uint32_t operand_idx_base_data;
        uint32_t operand_idx_base_index;
        uint32_t operand_idx_index_reg;
        uint32_t operand_idx_src_alias;
        uint32_t operand_idx_dest_src_alias; // alias updated with index[i]
    };
}};

def template LoadIndirectConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            uint32_t _dest, uint32_t _src_alias,
            uint32_t _base_data, uint32_t _base_index,
            uint32_t _index_reg) :
         ArmISA::MemoryInd64("%(mnemonic)s", machInst, %(op_class)s,
                 (RegIndex)_dest, (RegIndex)_base_index,
                 %(size_index)d, %(size_data)d)
    {
        setRegIdxArrays(
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::customSrcRegIdxArr),
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::customDestRegIdxArr));

        %(constructor)s;

        // Dest register (x4): dest operand 0, written in completeAcc Phase 2.
        operand_idx_dest = _numDestRegs++;
        setDestRegIdx(operand_idx_dest, intRegClass[_dest]);
        _numTypedDestRegs[intRegClass[_dest].classValue()]++;

        operand_idx_base_data = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_data, intRegClass[_base_data]);

        operand_idx_base_index = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_index, intRegClass[_base_index]);

        operand_idx_index_reg = _numSrcRegs++;
        setSrcRegIdx(operand_idx_index_reg, intRegClass[_index_reg]);

        // The implicit alias register is read to get the index value
        operand_idx_src_alias = _numSrcRegs++;
        setSrcRegIdx(operand_idx_src_alias, intRegClass[_src_alias]);

        // The implicit alias register is also WRITTEN (Phase 2 completion updates it)
        operand_idx_dest_src_alias = _numDestRegs++;
        setDestRegIdx(operand_idx_dest_src_alias, intRegClass[_src_alias]);
        _numTypedDestRegs[intRegClass[_src_alias].classValue()]++;
    }
}};

def template LoadIndirectExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
                            trace::InstRecord *traceData) const
    {
        panic("%(mnemonic)s: atomic (non-split) execution not supported; "
              "this instruction requires the Ruby CHI memory system.");
    }
}};

def template LoadIndirectInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        // === Phase 1: issue index fetch ===
        uint64_t base_index_val = xc->getRegOperand(this, operand_idx_base_index);
        uint64_t base_data_val  = xc->getRegOperand(this, operand_idx_base_data);
        uint64_t index_val      = xc->getRegOperand(this, operand_idx_index_reg);
        uint64_t alias_val      = xc->getRegOperand(this, operand_idx_src_alias);

        Addr EA = base_index_val + (index_val << shiftAmtIndex);

        DPRINTF(IndirectAccess, "[LDIND initiateAcc] alias=0x%llx base_data=0x%llx "
                "base_index=0x%llx raw_index=%llu EA=0x%llx sizeIndex=%u sizeData=%u\n",
                (unsigned long long)alias_val, (unsigned long long)base_data_val,
                (unsigned long long)base_index_val, (unsigned long long)index_val,
                (unsigned long long)EA, sizeIndex, sizeData);

        // Attach DependentAccessGen so Ruby can generate Phase 2.
        // sizeData is the data element size for genNextRequest.
        auto iaa = std::make_shared<IndirectAccessAlias>(alias_val);
        auto dag = std::make_shared<ArmISA::ARMDependentAccessGen>(
                       base_data_val, sizeData);
        xc->setIAAExt(iaa);
        xc->setDAGExt(dag);

        // Attach IndependentAccessResp so the cache can report index[i] back.
        // _destReg = the alias register that will receive index[i] value.
        // _seqNum  = 0 for TimingSimpleCPU (set by O3 LSQ when supported).
        // _indexValue starts at -1 (filled in by getDependentReq in Ruby).
        RegIndex alias_reg =
            this->destRegIdx(operand_idx_dest_src_alias).index();
        auto iar = std::make_shared<ArmISA::ARMIndependentAccessResp>(alias_reg);
        xc->setIARExt(iar);

        // Issue Phase 1 with the INDEX element size — this is what
        // og_request->getSize() returns in getDependentReq().
        unsigned flags = memAccessFlags;
        return initiateMemRead(xc, traceData, EA, sizeIndex, flags);
    }
}};

def template LoadIndirectCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        // Check whether this is a Phase 2 (data) response.
        auto resp_ext =
            pkt->req->getExtension<IndependentAccessResp>().get();

        if (resp_ext == nullptr) {
            // Phase 1 response reaching the CPU is unexpected in Ruby/CHI:
            // Ruby intercepts Phase 1 and generates Phase 2 internally.
            panic("%(mnemonic)s: unexpected Phase 1 response at CPU. "
                  "Is the Ruby CHI controller configured correctly?");
        }

        // --- Phase 2 response ---

        // Write index[i] value into the alias register.
        xc->setRegOperand(this, operand_idx_dest_src_alias, resp_ext->getIndexValue());

        // Read data element from packet and write into dest register.
        uint64_t data = 0;
        switch (sizeData) {
            case 1: {
                uint8_t v = 0;
                getMemLE(pkt, v, traceData);
                data = v;
                break;
            }
            case 2: {
                uint16_t v = 0;
                getMemLE(pkt, v, traceData);
                data = v;
                break;
            }
            case 4: {
                uint32_t v = 0;
                getMemLE(pkt, v, traceData);
                data = v;
                break;
            }
            case 8:
                getMemLE(pkt, data, traceData);
                break;
            default:
                panic("%(mnemonic)s: unsupported sizeData=%u", sizeData);
        }

        DPRINTF(IndirectAccess, "[LDIND completeAcc] indexValue=%lld data=0x%llx\n",
                (long long)resp_ext->getIndexValue(), (unsigned long long)data);

        // Write the data element into the destination register (x4).
        xc->setRegOperand(this, operand_idx_dest, data);

        return NoFault;
    }
}};

// ---------------------------------------------------------------------------
// Indirect Store (STIND) templates
// ---------------------------------------------------------------------------

def template StoreIndirectDeclare {{
    class %(class_name)s : public ArmISA::MemoryInd64
    {
      public:
        %(class_name)s(ExtMachInst machInst,
                       uint32_t _dest, uint32_t _src_alias,
                       uint32_t _base_data, uint32_t _base_index,
                       uint32_t _index_reg);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

      protected:
        RegId customSrcRegIdxArr[5];

        uint32_t operand_idx_src_data;
        uint32_t operand_idx_base_data;
        uint32_t operand_idx_base_index;
        uint32_t operand_idx_index_reg;
        uint32_t operand_idx_src_alias;
    };
}};

def template StoreIndirectConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst,
            uint32_t _dest, uint32_t _src_alias,
            uint32_t _base_data, uint32_t _base_index,
            uint32_t _index_reg) :
         ArmISA::MemoryInd64("%(mnemonic)s", machInst, %(op_class)s,
                 (RegIndex)_dest, (RegIndex)_base_index,
                 %(size_index)d, %(size_data)d)
    {
        setRegIdxArrays(
            reinterpret_cast<RegIdArrayPtr>(
                &std::remove_pointer_t<decltype(this)>::customSrcRegIdxArr),
            nullptr);

        %(constructor)s;

        operand_idx_src_data = _numSrcRegs++;
        setSrcRegIdx(operand_idx_src_data, intRegClass[_dest]);

        operand_idx_base_data = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_data, intRegClass[_base_data]);

        operand_idx_base_index = _numSrcRegs++;
        setSrcRegIdx(operand_idx_base_index, intRegClass[_base_index]);

        operand_idx_index_reg = _numSrcRegs++;
        setSrcRegIdx(operand_idx_index_reg, intRegClass[_index_reg]);

        operand_idx_src_alias = _numSrcRegs++;
        setSrcRegIdx(operand_idx_src_alias, intRegClass[_src_alias]);
    }
}};

def template StoreIndirectExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
                            trace::InstRecord *traceData) const
    {
        panic("%(mnemonic)s: atomic (non-split) execution not supported; "
              "this instruction requires the Ruby CHI memory system.");
    }
}};

def template StoreIndirectInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        uint64_t base_index_val = xc->getRegOperand(this, operand_idx_base_index);
        uint64_t base_data_val  = xc->getRegOperand(this, operand_idx_base_data);
        uint64_t index_val      = xc->getRegOperand(this, operand_idx_index_reg);
        uint64_t alias_val      = xc->getRegOperand(this, operand_idx_src_alias);
        uint64_t src_data_val   = xc->getRegOperand(this, operand_idx_src_data);

        Addr EA = base_index_val + (index_val << shiftAmtIndex);

        DPRINTF(IndirectAccess, "[STIND initiateAcc] alias=0x%llx base_data=0x%llx "
                "base_index=0x%llx raw_index=%llu data_to_store=0x%llx EA=0x%llx "
                "sizeIndex=%u sizeData=%u\n",
                (unsigned long long)alias_val, (unsigned long long)base_data_val,
                (unsigned long long)base_index_val, (unsigned long long)index_val,
                (unsigned long long)src_data_val,
                (unsigned long long)EA, sizeIndex, sizeData);

        auto iaa = std::make_shared<IndirectAccessAlias>(alias_val);
        auto dag = std::make_shared<ArmISA::ARMDependentAccessGen>(
                       base_data_val, sizeData);
        dag->setStoreData((const uint8_t*)&src_data_val, sizeData);
        xc->setIAAExt(iaa);
        xc->setDAGExt(dag);

        RegIndex alias_reg =
            this->srcRegIdx(operand_idx_src_alias).index();
        auto iar = std::make_shared<ArmISA::ARMIndependentAccessResp>(alias_reg);
        xc->setIARExt(iar);

        // Initiate a write to the index array. The O3 CPU will hold this in the
        // Store Queue until commit. The Ruby controller will intercept this WriteReq,
        // extract the index, and generate a WriteValue to the dependent data array.
        unsigned flags = memAccessFlags;
        std::vector<bool> byte_enable(sizeIndex, true);

        return xc->writeMem((uint8_t *)&src_data_val, sizeIndex, EA, flags, NULL, byte_enable);
    }
}};

def template StoreIndirectCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
                                trace::InstRecord *traceData) const
    {
        auto resp_ext =
            pkt->req->getExtension<IndependentAccessResp>().get();

        if (resp_ext == nullptr) {
            panic("%(mnemonic)s: unexpected Phase 1 response at CPU.");
        }

        // STIND is a scatter operation; we do not write the fetched index back
        // to the register file, as it is consumed internally by the memory system.

        DPRINTF(IndirectAccess, "[STIND completeAcc] indexValue=%lld\n",
                (long long)resp_ext->getIndexValue());

        return NoFault;
    }
}};
