action(Send_CompData_AR, desc="") {
  assert(is_valid(tbe));
  assert(tbe.dataValid);

  tbe.snd_msgType := CHIDataType:CompData_I;
  tbe.dataMaybeDirtyUpstream := false;
  tbe.requestorToBeExclusiveOwner := false;
  tbe.requestorToBeOwner := false;
  tbe.snd_destination := tbe.requestor;
  setupPendingSend(tbe);
  printTBEState(tbe);

}

action(Send_Comp_ANR, desc="") {
  assert(is_valid(tbe));
  enqueue(rspOutPort, CHIResponseMsg, comp_anr_latency + response_latency) {
    out_msg.addr := address;
    out_msg.type := CHIResponseType:Comp;
    out_msg.responder := machineID;
    out_msg.Destination.add(tbe.requestor);
  }
}


action(Send_SnpRespI, desc="") {
  enqueue(rspOutPort, CHIResponseMsg, response_latency) {
    out_msg.addr := address;
    if (tbe.is_dvm_tbe || tbe.is_dvm_snp_tbe) {
      out_msg.usesTxnId := true;
      out_msg.txnId := tbe.addr;
    }
    out_msg.type := CHIResponseType:SnpResp_I;
    out_msg.responder := machineID;
    out_msg.Destination.add(tbe.requestor);
    // MYSTUFF: the copy's lifetime set goes down with the response.
    out_msg.life_origin := tbe.dataBlk.getLifeOrigin();
    out_msg.life_origin_mask := tbe.dataBlk.getLifeOriginMask();
    out_msg.life_others_mask := tbe.dataBlk.getLifeOthersMask();
    // FFUTSYM
  }
}

action(Send_RetryAck, desc="") {
  peek(retryTriggerInPort, RetryTriggerMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := in_msg.addr;
      out_msg.usesTxnId := in_msg.usesTxnId;
      out_msg.type := CHIResponseType:RetryAck;
      out_msg.responder := machineID;
      out_msg.Destination.add(in_msg.retryDest);
      out_msg.txnId := in_msg.txnId;
    }
  }
}

action(Send_PCrdGrant, desc="") {
  peek(retryTriggerInPort, RetryTriggerMsg) {
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := in_msg.addr;
      out_msg.usesTxnId := in_msg.usesTxnId;
      out_msg.type := CHIResponseType:PCrdGrant;
      out_msg.responder := machineID;
      out_msg.Destination.add(in_msg.retryDest);
    }
  }
}

// Note on CheckUpgrade_FromStoreOrRU/CheckUpgrade_FromCU
// We will always get Comp_UC; but if our data is invalidated before
// Comp_UC we would need to go to UCE. Since we don't use the UCE state
// we remain in the transient state and follow-up with ReadUnique.
// Note this assumes the responder knows we have invalid data when sending
// us Comp_UC and does not register us as owner.

action(CheckUpgrade_FromStoreOrRU, desc="") {
  assert(is_HN == false);
  if (tbe.dataUnique) {
    // success, just send CompAck next
    assert(tbe.dataValid);
  } else {
    // will need to get data instead
    tbe.actions.pushFront(Event:SendReadUnique);
    // we must have received an invalidation snoop that marked
    // the req as stale
    assert(tbe.is_stale);
    tbe.is_stale := false;
  }
  tbe.actions.pushFront(Event:SendCompAck);
}

action(CheckUpgrade_FromCU, desc="") {
  assert(is_HN == false);
  if (tbe.dataUnique == false) {
    // actually failed, so just cancel the directory update
    assert(tbe.dir_sharers.isElement(tbe.requestor) == false);
    tbe.requestorToBeExclusiveOwner := false;
    tbe.updateDirOnCompAck := false;
  }
  // otherwise nothing else to do here other than acking the CleanUnique
  tbe.actions.pushFront(Event:SendCompAck);
}

action(Finalize_UpdateCacheFromTBE, desc="") {
  assert(is_valid(tbe));
  State final := tbe.finalState;
  if ((final == State:UD_RSC) || (final == State:SD_RSC) || (final == State:UC_RSC) ||
      (final == State:SC_RSC) || (final == State:UD)     || (final == State:UD_T) ||
      (final == State:SD)     || (final == State:UC)     || (final == State:SC) ||
      (final == State:UC_RU)  || (final == State:UD_RU)  || (final == State:UD_RSD) ||
      (final == State:SD_RSD)) {
    assert(tbe.dataBlkValid.isFull());
    assert(tbe.dataValid);
    assert(is_valid(cache_entry));
    cache_entry.DataBlk := tbe.dataBlk;

    // MYSTUFF
    cache_entry.indirect_unit_id := tbe.indirect_unit_id;
    cache_entry.value_unit_id := tbe.value_unit_id;
    cache_entry.gather_unit_id := tbe.gather_unit_id;
    DPRINTF(Usefulness, "Inside Finalize_UpdateCacheFromTBE. Before calling functions from DataBlock.\n");
    // cache_entry.DataBlk.copyReadUsefulness(tbe.dataBlk.getReadUsefulness(getName(), address), getName(), address);
    // cache_entry.DataBlk.copyWriteUsefulness(tbe.dataBlk.getWriteUsefulness(getName(), address), getName(), address);
    cache_entry.DataBlk.reduceUsefulness(tbe.dataBlk.getReadUsefulness(getName(), address), tbe.dataBlk.getWriteUsefulness(getName(), address), getName(), address);
    cache_entry.DataBlk.setIsPrefetched(tbe.is_local_pf || tbe.is_remote_pf, getName(), address);
    cache_entry.DataBlk.setAccessName(tbe.access_name, canOverride(cache_entry.DataBlk.getAccessName(getName(), address), address), getName(), address);
    DPRINTF(Usefulness, "Inside Finalize_UpdateCacheFromTBE. After calling functions from DataBlock.\n");
    // FFUTSYM

    DPRINTF(RubySlicc, "Cached data %s pfb %s\n", tbe.dataBlk, cache_entry.HWPrefetched);
  } else {
    // make sure only deallocate the cache entry if data is invalid
    assert(tbe.dataValid == false);
    if (is_valid(cache_entry)) {
      // MYSTUFF
      // The line leaves without a replacement (an invalidating snoop, a
      // back-invalidate, or a deallocation on a unique request from
      // upstream): sample the bytes used during its stay, the block's own
      // and those the Sequencer marked in the TBE during this transaction,
      // apart from replacements (sampled in Initiate_Replacement).
      if (profile_usefulness && cache_entry.DataBlk.isAlloc()) {
        WriteMask read_usefulness := cache_entry.DataBlk.getReadUsefulness(getName(), address);
        WriteMask write_usefulness := cache_entry.DataBlk.getWriteUsefulness(getName(), address);
        if (tbe.dataBlk.isAlloc()) {
          read_usefulness.orMask(tbe.dataBlk.getReadUsefulness(getName(), address));
          write_usefulness.orMask(tbe.dataBlk.getWriteUsefulness(getName(), address));
        }
        cache.profileInvalidationUsefulness(
          cache_entry.DataBlk.getAccessName(getName(), address),
          read_usefulness, write_usefulness);
      }
      // FFUTSYM
      cache.deallocate(address);
      unset_cache_entry();
    }
    // MYSTUFF
    // The line leaves without a replacement (an invalidating snoop, or the
    // Gather Unit's back-invalidate, on its own or as a hazard during a
    // request) while a DAG is stashed for it: the stash becomes a
    // notification through the Sequencer. A replacement took the stash in
    // Initiate_Replacement, so it never gets here.
    if (hasStash(address)) {
      assert(tbe.is_repl_tbe == false);
      assert(indirect_unit);
      DPRINTF(IndirectAccess, "Stash for %#lx orphaned by a snoop: notifying.\n", address);
      sequencer.deliverDAGReq(address, takePostEvictDAG(address));
      countStashOrphaned();
    }
    // FFUTSYM
  }
}

action(Finalize_UpdateDirectoryFromTBE, desc="") {
  assert(is_valid(tbe));
  State final := tbe.finalState;
  if ((final == State:UD_RSC) || (final == State:SD_RSC) || (final == State:UC_RSC) ||
      (final == State:SC_RSC) || (final == State:UC_RU)  || (final == State:UD_RU) ||
      (final == State:UD_RSD) || (final == State:SD_RSD) || (final == State:RU) ||
      (final == State:RSC)    || (final == State:RSD)    || (final == State:RUSD) ||
      (final == State:RUSC)) {
    DirEntry dir_entry := getDirEntry(address);
    assert(is_valid(dir_entry));
    assert(tbe.dir_sharers.count() > 0);
    dir_entry.ownerExists := tbe.dir_ownerExists;
    dir_entry.ownerIsExcl := tbe.dir_ownerIsExcl;
    dir_entry.owner := tbe.dir_owner;
    dir_entry.sharers := tbe.dir_sharers;
    dir_entry.indirect_unit_id := tbe.indirect_unit_id;
    dir_entry.value_unit_id := tbe.value_unit_id;
    dir_entry.gather_unit_id := tbe.gather_unit_id;
  } else {
    assert((tbe.dir_ownerExists == false) && tbe.dir_sharers.isEmpty());
    if(directory.isTagPresent(address)) {
      directory.deallocate(address);
    }
  }
}

action(Deallocate_CacheBlock, desc="") {
  assert(is_valid(cache_entry));
  cache.deallocate(address);
  unset_cache_entry();
}

action(Allocate_DirEntry, desc="") {
  assert(directory.isTagPresent(address) == false);
  directory.allocate(address);
}

action(Deallocate_DirEntry, desc="") {
  assert(directory.isTagPresent(address));
  directory.deallocate(address);
}

action(CheckCacheFill, desc="") {
  assert(is_valid(tbe));

  // only perform the write if we have valid data and need to write
  // MYSTUFF: NOTE: Need to understand what dataValid and dataToBeInvalid mean?
  bool need_fill := tbe.dataValid && (tbe.dataToBeInvalid == false) && tbe.doCacheFill;
  bool execute_next := true;

  if (need_fill && is_valid(cache_entry)) {
    // can write
    tbe.actions.pushFront(Event:DataArrayWrite);
    tbe.actions.pushFront(Event:FillPipe);
  } else if (need_fill && cache.cacheAvail(address)) {
    // don't have a cache block, but there is space to allocate one
    set_cache_entry(cache.allocate(address, new CacheEntry));
    // MYSTUFF:
    // bytes brought in and kept, per access name (bytesTransferred at the
    // sender counts pass-through responses too, e.g. index lines the
    // Indirect Unit does not cache)
    cache.profileAllocation(tbe.access_name);
    DPRINTF(Usefulness, "Inside CheckCacheFill. Before calling functions from DataBlock.\n");
    cache_entry.DataBlk.setAccessName("reset", true, getName(), address);
    DPRINTF(Usefulness, "Inside CheckCacheFill. After calling functions from DataBlock.\n");
    // FFUTSYM:
    tbe.actions.pushFront(Event:DataArrayWriteOnFill);
    tbe.actions.pushFront(Event:FillPipe);

  } else if (need_fill) {
    // performs a cache block replacement. CheckCacheFill executes again
    // after the replacement
    execute_next := false;

    // pick a victim to deallocate
    Addr victim_addr := cache.cacheProbe(address);
    CacheEntry victim_entry := getCacheEntry(victim_addr);
    assert(is_valid(victim_entry));
    TBE victim_tbe := getCurrentActiveTBE(victim_addr);

    // The `is_valid(victim_entry)` condition here is to avoid an unused
    // variable error when compiling to gem5.fast.
    if (is_invalid(victim_tbe) && is_valid(victim_entry)) {
      DPRINTF(RubySlicc, "Eviction for %#x victim: %#x state=%s\n",
                          address, victim_addr, victim_entry.state);
      enqueue(replTriggerOutPort, ReplacementMsg, 0) {
        out_msg.addr := victim_addr;
        out_msg.from_addr := address;
        if (unify_repl_TBEs) {
          out_msg.slot := tbe.storSlot;
          DPRINTF(RubySlicc, "Reusing slot %d\n", out_msg.slot);
        }
      }
    } else {
      DPRINTF(RubySlicc, "Eviction for %#x victim: %#x state=%s\n",
                          address, victim_addr, victim_tbe.state);
      // just wait until the transaction finishes to try again
      victim_tbe.wakeup_pending_tgr := true;
    }

    // wait until we can deallocate the victim_addr
    stall_and_wait(triggerInPort, victim_addr);
  }

  // only do the usual Pop_TriggerQueue+ProcessNextState if we have a block
  if (execute_next) {
    triggerInPort.dequeue(clockEdge());
    clearPendingAction(tbe);
    processNextState(address, tbe, cache_entry);
  } else {
    wakeupPendingSnps(tbe); // might have stalled snoops that can execute now
  }
}


action(Finalize_DeallocateRequest, desc="") {
  assert(is_valid(tbe));
  assert(tbe.actions.empty());

  wakeupPendingReqs(tbe);
  wakeupPendingSnps(tbe);
  wakeupPendingTgrs(tbe);

  // Index-line post-processing (IDRs at the Gather Unit, StashAndPostEvict
  // above it) has run by now: processNextState pushes PostProcess until
  // needsPostProcess is false, and only then Final.

  // MYSTUFF: the line leaves the chip when the home, whose downstream is
  // memory, ends an eviction (or its own replacement) with no copy and no
  // sharer left: sample the lifetime set the eviction and the snoops
  // brought.
  if (profile_usefulness && is_HN && (tbe.finalState == State:I) &&
      (tbe.is_repl_tbe || (tbe.is_req_tbe && isConsideredEvict(tbe.reqType)))) {
    if (machineIDToMachineType(mapAddressToDownstreamMachine(address)) ==
        MachineType:Memory) {
      cache.profileLifetime(tbe.dataBlk, tbe.access_name, false);
    }
  }

  // The target flow: an injected request's tracker slot is free once the
  // block reached the Indirect Unit (or was declined); a TBE that waited
  // for an expected block no longer needs its timer.
  if (tbe.is_req_tbe && tbe.hov_fwd) {
    storHovTBEs.removeEntryFromSlot(tbe.hov_slot);
    if (tbe.hov_declined) {
      hovTrackerClose(tbe.hov_slot, 1, idr_coalesce);
    } else {
      hovTrackerClose(tbe.hov_slot, 0, idr_coalesce);
    }
  }
  if (tbe.is_req_tbe && (tbe.hov_recv == 1) && hovExpectTimers.isSet(address)) {
    hovExpectTimers.unset(address);
  }
  // FFUTSYM

  if (tbe.is_req_tbe) {
    deallocateReqTBE(tbe);
    processRetryQueue();

  } else if (tbe.is_snp_tbe) {
    deallocateSnpTBE(tbe);

  } else {
    deallocateReplacementTBE(tbe);
    if (unify_repl_TBEs) {
      processRetryQueue();
    }
  }
  unset_tbe();

  incomingTransactionEnd(address, curTransitionNextState());
}

action(Finalize_DeallocateDvmRequest, desc="") {
  assert(is_valid(tbe));
  assert(tbe.actions.empty());
  wakeupPendingReqs(tbe);
  wakeupPendingSnps(tbe);
  wakeupPendingTgrs(tbe);

  // Don't call processRetryQueue() because DVM ops don't interact with the retry queue

  assert(tbe.is_dvm_tbe);
  deallocateDvmTBE(tbe);
  unset_tbe();
}

action(Finalize_DeallocateDvmSnoop, desc="") {
  assert(is_valid(tbe));
  assert(tbe.actions.empty());
  wakeupPendingReqs(tbe);
  wakeupPendingSnps(tbe);
  wakeupPendingTgrs(tbe);

  // Don't call processRetryQueue() because DVM ops don't interact with the retry queue

  assert(tbe.is_dvm_snp_tbe);
  deallocateDvmSnoopTBE(tbe);
  unset_tbe();

  // Last argument = false, so it uses a "unique ID" rather than an address
  incomingTransactionEnd(address, curTransitionNextState(), false);
}

action(Pop_ReqRdyQueue, desc="") {
  reqRdyPort.dequeue(clockEdge());
}

action(Pop_RespInQueue, desc="") {
  rspInPort.dequeue(clockEdge());
}

action(Pop_SnoopRdyQueue, desc="") {
  snpRdyPort.dequeue(clockEdge());
}

action(Pop_DataInQueue, desc="") {
  datInPort.dequeue(clockEdge());
}

// NOTICE a trigger event may wakeup another stalled trigger event so
// this is always called first in the transitions so we don't pop the
// wrong message
action(Pop_TriggerQueue, desc="") {
  triggerInPort.dequeue(clockEdge());
}

action(Pop_ReplTriggerQueue, desc="") {
  replTriggerInPort.dequeue(clockEdge());
  // wakeup the transaction that triggered this eviction
  wakeup_port(triggerInPort, address);
}

action(Pop_RetryTriggerQueue, desc="") {
  retryTriggerInPort.dequeue(clockEdge());
}

action(Pop_SnpInPort, desc="") {
  snpInPort.dequeue(clockEdge());
}
action(Pop_SeqInPort, desc="") {
  seqInPort.dequeue(clockEdge());
}

action(ProcessNextState, desc="") {
  assert(is_valid(tbe));
  processNextState(address, tbe, cache_entry);
}

action(ProcessNextState_ClearPending, desc="") {
  assert(is_valid(tbe));
  clearPendingAction(tbe);
  processNextState(address, tbe, cache_entry);
}

action(Callback_LoadHit, desc="") {
  assert(is_valid(tbe));
  assert(tbe.reqType == CHIRequestType:Load);

  // MYSTUFF
  // Two-uop model: only the index access (uop0, ReadIndex) calls back;
  // the CPU extracts index[i] from the line and writes it to Rd+1.
  // An IDR's transaction (isHovIdr) never calls back: it only brings the
  // line to the Indirect Unit, and the core's own value access (uop1) is
  // a Load/Store that calls back as any other.
  if (isIndirectIdx(tbe.reqType, tbe.secondType) || isHovIdr(tbe)) {
    if (tbe.dataValid && (tbe.reqType == CHIRequestType:Load)) {
        DPRINTF(IndirectAccess, "Finished servicing a hit for a load to addr %#lx.\n", tbe.addr);
        if (tbe.secondType == CHIRequestType:ReadIndex) {
            DPRINTF(IndirectAccess, "Load to addr %#lx was to an index. Calling back to CPU.\n", tbe.addr);
            sequencer.readCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, true);
        }
    }
  // FFUTSYM
  } else if (tbe.is_local_pf == false) {
    assert(tbe.dataValid);
    DPRINTF(RubySlicc, "Read data %s\n", tbe.dataBlk);
    sequencer.readCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, false);
  }
}

action(Callback_StoreHit, desc="") {
  assert(is_valid(tbe));
  assert((tbe.reqType == CHIRequestType:StoreLine) ||
         (tbe.reqType == CHIRequestType:Store));
  // MYSTUFF
  // An IDR's transaction only brings the line (writable for stind): no
  // callback and no data written. The core's own value store (uop1) is a
  // normal store that writes the data.
  if (isHovIdr(tbe)) {
    DPRINTF(IndirectAccess, "IDR store hit at %#lx. No callback.\n", tbe.addr);
  // FFUTSYM
  } else if (tbe.is_local_pf == false) {
    assert(tbe.dataValid);
    DPRINTF(RubySlicc, "Write before %s\n", tbe.dataBlk);
    sequencer.writeCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, false);
    DPRINTF(RubySlicc, "Write after %s\n", tbe.dataBlk);
    tbe.dataDirty := true;
  }
}

action(Callback_AtomicHit, desc="") {
  assert(is_valid(tbe));
  assert(tbe.dataValid);
  assert((tbe.reqType == CHIRequestType:AtomicLoad) ||
         (tbe.reqType == CHIRequestType:AtomicStore));
  DPRINTF(RubySlicc, "Atomic before %s\n", tbe.dataBlk);

  DataBlock oldDataBlk;
  oldDataBlk := tbe.dataBlk;
  tbe.dataBlk.atomicPartial(tbe.dataBlk, tbe.atomic_op);
  tbe.dataBlk.clearAtomicLogEntries();

  sequencer.atomicCallback(tbe.addr, oldDataBlk, false);
  DPRINTF(RubySlicc, "Atomic after %s\n", tbe.dataBlk);
  tbe.dataDirty := true;
}

action(Callback_ExpressPrefetchHit, desc="") {
  // have not allocated TBE, but must clear the reservation
  assert(is_invalid(tbe));
  storTBEs.decrementReserved();
  storSeqTBEs.decrementReserved();
  assert(storTBEs.areNSlotsAvailable(1));
  assert(use_prefetcher);

  cache.profilePrefetchHit();
  peek(reqRdyPort, CHIRequestMsg) {
    assert(in_msg.is_local_pf);
    pfProxy.completePrefetch(in_msg.addr);
  }
}

// This is called everytime a data message is received but only goes
// though once all the blocks are present (tbe.dataValid)
// NOTE: should create a separate trigger for this callback ?
action(Callback_Miss, desc="") {
  assert(is_valid(tbe));
  // MYSTUFF
  // Two-uop model: only the index access (uop0, ReadIndex) calls back.
  // An IDR's transaction (isHovIdr: a waiting or delivered block at the
  // Indirect Unit) never calls back; see Callback_LoadHit.
  if (isIndirectIdx(tbe.reqType, tbe.secondType) || isHovIdr(tbe)) {
    if (tbe.dataValid && (tbe.reqType == CHIRequestType:Load)) {
        DPRINTF(IndirectAccess, "Finished servicing a miss for a load to addr %#lx.\n", tbe.addr);
        if (tbe.secondType == CHIRequestType:ReadIndex) {
            DPRINTF(IndirectAccess, "Load to addr %#lx was to an index. Calling back to CPU.\n", tbe.addr);
            sequencer.readCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, true);
        }
    }
  // FFUTSYM
  } else if (tbe.dataValid && tbe.is_local_pf) {
    assert(use_prefetcher);
    pfProxy.completePrefetch(tbe.addr);
  } else if (tbe.dataValid && (tbe.reqType == CHIRequestType:Load)) {
        DPRINTF(RubySlicc, "Read data %s\n", tbe.dataBlk);
        sequencer.readCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, true);
  } else if (tbe.dataValid && ((tbe.reqType == CHIRequestType:Store) ||
                               (tbe.reqType == CHIRequestType:StoreLine))) {
    DPRINTF(RubySlicc, "Write before %s\n", tbe.dataBlk);
    sequencer.writeCallback(tbe.addr, tbe.accAddr, tbe.dataBlk, true);
    DPRINTF(RubySlicc, "Write after %s\n", tbe.dataBlk);
    tbe.dataDirty := true;

    // sets a use time out for store misses to prevent LL/SC livelocks
    int use_timeout_latency := scLockLatency();
    if (use_timeout_latency > 0) {
      if (tbe.hasUseTimeout) {
        assert(useTimerTable.isSet(tbe.addr));
      } else {
        useTimerTable.set(
                tbe.addr,
                clockEdge() + cyclesToTicks(intToCycles(use_timeout_latency)));
        tbe.hasUseTimeout := true;
      }
      // also decay the timeout
      scLockDecayLatency();
    }
  } else if (tbe.dataValid && tbe.atomic_to_be_done &&
                ((tbe.reqType == CHIRequestType:AtomicLoad) ||
                 (tbe.reqType == CHIRequestType:AtomicStore))){
    assert(is_valid(tbe));
    assert(tbe.dataValid);
    assert((tbe.reqType == CHIRequestType:AtomicLoad) ||
           (tbe.reqType == CHIRequestType:AtomicStore));
    DPRINTF(RubySlicc, "Atomic before %s\n", tbe.dataBlk);

    DataBlock oldDataBlk;
    oldDataBlk := tbe.dataBlk;
    tbe.dataBlk.atomicPartial(tbe.dataBlk, tbe.atomic_op);
    tbe.dataBlk.clearAtomicLogEntries();

    sequencer.atomicCallback(tbe.addr, oldDataBlk, false);
    DPRINTF(RubySlicc, "Atomic after %s\n", tbe.dataBlk);
    tbe.dataDirty := true;
  } else if (tbe.dataValid && tbe.dataAMOValid && (tbe.reqType == CHIRequestType:AtomicLoad)) {
    DPRINTF(RubySlicc, "Atomic before %s\n", tbe.oldDataBlk);
    sequencer.atomicCallback(tbe.addr, tbe.oldDataBlk, false);
  }
}

action(Unset_Timeout_TBE, desc="") {
  assert(is_valid(tbe));
  assert(tbe.hasUseTimeout);
  assert(useTimerTable.isSet(tbe.addr));
  useTimerTable.unset(tbe.addr);
  tbe.hasUseTimeout := false;
  // A snoop may have been stalled without setting the TBE flag
  wakeup_port(snpRdyPort, address);
}

action(Unset_Timeout_Cache, desc="") {
  assert(useTimerTable.isSet(address));
  useTimerTable.unset(address);
  wakeup_port(snpRdyPort, address);
}

action(Callback_AtomicNoReturn, desc="") {
  assert(is_valid(tbe));
  assert((tbe.is_local_pf || tbe.is_remote_pf) == false);
  assert((tbe.reqType == CHIRequestType:AtomicNoReturn) ||
	 (tbe.reqType == CHIRequestType:AtomicStore));

  if(tbe.reqType == CHIRequestType:AtomicStore){
    sequencer.atomicCallback(tbe.addr, tbe.dataBlk);
    DPRINTF(RubySlicc, "AtomicNoReturn %s\n", tbe.dataBlk);
  }
}

action(Callback_WriteUnique, desc="") {
  assert(is_valid(tbe));
  assert((tbe.is_local_pf || tbe.is_remote_pf) == false);
  assert((tbe.reqType == CHIRequestType:StoreLine) ||
         (tbe.reqType == CHIRequestType:Store));
  assert(tbe.dataValid == false);
  sequencer.writeUniqueCallback(tbe.addr, tbe.dataBlk);
  DPRINTF(RubySlicc, "WriteUnique data %s\n", tbe.dataBlk);
  // set mask; note data is never considered valid
  assert(tbe.dataBlkValid.isEmpty());
  tbe.dataBlkValid.setMask(addressOffset(tbe.accAddr, tbe.addr), tbe.accSize);
}

action(Profile_Miss, desc="") {
  assert(is_valid(tbe));
  bool is_demand := (tbe.is_local_pf || tbe.is_remote_pf) == false;
  bool is_remote_can_notify := tbe.is_remote_pf && upstream_prefetch_trains_prefetcher;
  // MYSTUFF: IDRs and index accesses are counted apart from demand
  if (is_demand == false) {
    assert(use_prefetcher || tbe.is_remote_pf);
    cache.profilePrefetchMiss(tbe.access_name);
  } else if (isHovIdr(tbe)) {
    cache.profileIdrMiss(tbe.access_name);
    if (tbe.hov_spec) {
      cache.profileIdrSpecMiss(tbe.access_name);
    }
  } else if (isIndirectIdx(tbe.reqType, tbe.secondType)) {
    cache.profileIndexMiss(tbe.access_name);
  } else {
    cache.profileDemandMiss(tbe.access_name);
  }
  // FFUTSYM
  // notify prefetcher about this demand miss
  if (use_prefetcher && tbe.isSeqReqValid && (is_demand || is_remote_can_notify) &&
      shouldNotifyPrefetcher(tbe.reqType, tbe.secondType)) {
    bool is_read := false;
    if (isReadReqType(tbe.reqType)) {
      is_read := true;
    } else {
      // HACK: Is this assert really correct and necessary?
      // assert(isWriteReqType(tbe.reqType));
    }

    // FIXME: this dataBlk is likely to have stale data. This should be fixed
    // if our prefetcher uses cached data to make prefetch decisions.
    pfProxy.notifyPfMiss(tbe.seqReq, is_read, tbe.dataBlk);
  }
}

action(Profile_Hit, desc="") {
  assert(is_valid(tbe));
  assert(is_valid(cache_entry));
  assert(tbe.dataValid);
  bool is_demand := (tbe.is_local_pf || tbe.is_remote_pf) == false;
  bool is_remote_can_notify := tbe.is_remote_pf && upstream_prefetch_trains_prefetcher;
  // MYSTUFF: IDRs and index accesses are counted apart from demand
  if (is_demand == false) {
    assert(use_prefetcher || tbe.is_remote_pf);
    cache.profilePrefetchHit(tbe.access_name);
  } else if (isHovIdr(tbe)) {
    cache.profileIdrHit(tbe.access_name);
    if (tbe.hov_spec) {
      cache.profileIdrSpecHit(tbe.access_name);
    }
  } else if (isIndirectIdx(tbe.reqType, tbe.secondType)) {
    cache.profileIndexHit(tbe.access_name);
  } else {
    cache.profileDemandHit(tbe.access_name);
  }
  // FFUTSYM
  // notify prefetcher about this demand hit
  if (use_prefetcher && tbe.isSeqReqValid && (is_demand || is_remote_can_notify) &&
      shouldNotifyPrefetcher(tbe.reqType, tbe.secondType)) {
    bool is_read := false;
    if (isReadReqType(tbe.reqType)) {
      is_read := true;
    } else {
      // HACK: Is this assert really correct and necessary?
      // assert(isWriteReqType(tbe.reqType));
    }
    pfProxy.notifyPfHit(tbe.seqReq, is_read, tbe.dataBlk);

    cache_entry.HWPrefetched := false;
  }
}

// MYSTUFF
// Gather Unit: a notification's index line has its data here (hit), or
// the line must be fetched from upstream or downstream first (miss).
action(Profile_GatherHit, desc="") {
  assert(is_valid(tbe));
  assert(gather_unit);
  cache.profileGatherHit(tbe.access_name);
}

action(Profile_GatherMiss, desc="") {
  assert(is_valid(tbe));
  assert(gather_unit);
  cache.profileGatherMiss(tbe.access_name);
}
// FFUTSYM

action(Profile_Fill, desc="") {
  assert(is_valid(tbe));
  assert(is_valid(cache_entry));
  if (use_prefetcher && tbe.isSeqReqValid && shouldNotifyPrefetcher(tbe.reqType, tbe.secondType)) {

    cache_entry.HWPrefetched := tbe.is_local_pf ||
                          (tbe.is_remote_pf &&
                            (upstream_prefetch_trains_prefetcher == false));
    cache_entry.requestor := getRequestorID(tbe.seqReq);

    // Prefetchers that use this info require notifications from both
    // demand and pf fills (unlike notifyPfHit/notifyPfMiss)
    pfProxy.notifyPfFill(tbe.seqReq, tbe.dataBlk, tbe.is_local_pf);
  }
}

action(Profile_Eviction, desc="") {
  if (sc_lock_enabled && sequencer.llscCheckMonitor(address)) {
    DPRINTF(LLSC, "Invalidating monitored address %#x\n", address);
    scLockIncLatency();
  }
  if (send_evictions) {
    // MYSTUFF
    // A post-evict (the index line leaves because its DAG rides the
    // write-back; the Gather Unit keeps the line and no writer intervened)
    // is a policy eviction, not an invalidation: the values the core's
    // loads read stay current, so the LSQ gets no InvalidateReq and
    // replays no load for it. Snoops and back-invalidates still send it.
    if (is_valid(tbe) && (tbe.secondType == CHIRequestType:PropagateEvict)) {
      DPRINTF(RubySlicc, "Post-evict of %#x: no invalidation to the sequencer\n", address);
    } else {
      DPRINTF(RubySlicc, "Sending invalidation for %#x to the sequencer\n", address);
      sequencer.evictionCallback(address);
    }
    // FFUTSYM
  }
  if (use_prefetcher && is_valid(cache_entry)) {
    pfProxy.notifyPfEvict(address, cache_entry.HWPrefetched, cache_entry.requestor);
  }
}

action(Profile_OutgoingStart, desc="") {
  outgoingTransactionStart(address, curTransitionEvent());
}

action(Profile_OutgoingEnd_DataResp, desc="") {
  assert(is_valid(tbe));
  // completes once all data is received
  // MYSTUFF: a TBE that waited for or took a delivered block sent nothing
  if (tbe.expected_req_resp.hasReceivedData() && (tbe.hov_recv == 0)) {
    outgoingTransactionEnd(address, tbe.rcvdRetryAck);
  }
  // FFUTSYM
}

action(Profile_OutgoingEnd_DatalessResp, desc="") {
  assert(is_valid(tbe));
  outgoingTransactionEnd(address, tbe.rcvdRetryAck);
}

action(TagArrayRead, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(
  tagLatency(fromSequencer(tbe.reqType)));
}

action(TagArrayWrite, desc="") {
  assert(is_valid(tbe));
  // when hasUseTimeout is set the final state is UD_T, but adding a delay
  // between now and triggering Fin_UD_T may allow the timer to expire and then
  // we end up in the wrong state
  if (dealloc_wait_for_tag && (tbe.hasUseTimeout == false)) {
    tbe.delayNextAction := curTick() + cyclesToTicks(tagLatency(false));
  }
}

action(DataArrayRead, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(dataLatency());
}

action(DataArrayWrite, desc="") {
  assert(is_valid(tbe));
  assert(is_valid(cache_entry));
  assert(tbe.doCacheFill);
  if(wait_for_cache_wr) {
    tbe.delayNextAction := curTick() + cyclesToTicks(dataLatency());
  }
}

action(ReadHitPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(read_hit_latency);
}

action(ReadMissPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(read_miss_latency);
}

action(WriteFEPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(write_fe_latency);
}

action(WriteBEPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(write_be_latency);
}

action(FillPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(fill_latency);
}

action(DelayAtomic, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(atomic_op_latency);
}

action(SnpSharedPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(snp_latency);
}

action(SnpInvPipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(snp_latency + snp_inv_latency);
}

action(SnpOncePipe, desc="") {
  assert(is_valid(tbe));
  tbe.delayNextAction := curTick() + cyclesToTicks(snp_latency);
}

//////////////////////////////////
// DVM Actions

action(Send_DvmTlbi, desc="") {
  enqueue(reqOutPort, CHIRequestMsg, request_latency) {
    prepareRequest(tbe, CHIRequestType:DvmOpNonSync, out_msg);
    DPRINTF(RubyProtocol, "Sending DvmOpNonSync to %d\n", getMiscNodeMachine());

    out_msg.usesTxnId := true;
    out_msg.txnId := tbe.addr; // for DVM TBEs addr = txnId

    out_msg.Destination.clear();
    out_msg.Destination.add(getMiscNodeMachine());
    out_msg.dataToFwdRequestor := false;

    // Don't set message size, we don't use the data inside the messages

    allowRequestRetry(tbe, out_msg);
  }

  // TLBIs can be ended early if the MN chooses to send CompDBIDResp.
  // Otherwise, the MN sends a plain DBIDResp, and then sends a Comp later.
  // => We add two possible response types, then add 1 to the count
  // e.g. "expect exactly 1 (CompDBIDResp OR DBIDResp)"
  clearExpectedReqResp(tbe);
  tbe.expected_req_resp.addExpectedRespType(CHIResponseType:CompDBIDResp);
  tbe.expected_req_resp.addExpectedRespType(CHIResponseType:DBIDResp);
  tbe.expected_req_resp.addExpectedCount(1);
  // If a plain DBIDResp is recieved, then Comp will be manually expected.
  // (expect_sep_wu_comp also sort of handles this, but it's WU specific,
  // and ProcessNextState doesn't respect it).

  // Push a value to the list of pending NonSyncs
  // The actual value doesn't matter, but we have to pick
  // a type which already has function signatures
  // e.g. TriggerQueue has push(Event) specified in SLICC but not push(addr)
  DPRINTF(RubyProtocol, "Pushing pending nonsync to blocklist %16x\n", tbe.addr);
  dvmPendingNonSyncsBlockingSync.push(Event:DvmTlbi_Initiate);
}

// Try to send a DVM Sync, but put it in the pending slot
// if there are pending Non-Syncs blocking it.
action(Try_Send_DvmSync, desc="") {
  if (dvmPendingNonSyncsBlockingSync.empty()){
    DPRINTF(RubyProtocol, "Nonsync queue is empty so %016x can proceed\n", tbe.addr);
    tbe.actions.push(Event:DvmSync_Send);
  } else {
    assert(!dvmHasPendingSyncOp);
    DPRINTF(RubyProtocol, "Nonsync queue is not empty so %016x is now pending\n", tbe.addr);
    dvmHasPendingSyncOp := true;
    dvmPendingSyncOp := address;
  }
}

// Try to send a DVM sync that was put in the pending slot
// due to pending Non-Syncs blocking it. Those Non-Syncs may not be
// blocking it anymore.
action(Try_Send_Pending_DvmSync, desc="") {
  // Pop an element off the list of pending NonSyncs
  // It won't necessarily be ours, but that doesn't matter.
  assert(!dvmPendingNonSyncsBlockingSync.empty());
  DPRINTF(RubyProtocol, "Popping nonsync from blocklist %16x\n", tbe.addr);
  dvmPendingNonSyncsBlockingSync.pop();

  if (dvmPendingNonSyncsBlockingSync.empty() && dvmHasPendingSyncOp) {
    DPRINTF(RubyProtocol, "Blocklist now empty, pending op %16x can proceed\n", dvmPendingSyncOp);
    TBE syncTBE := getDvmTBE(dvmPendingSyncOp);
    assert(is_valid(syncTBE));
    syncTBE.actions.push(Event:DvmSync_Send);

    dvmHasPendingSyncOp := false;
  }
}

action(Send_DvmSync, desc="") {
  enqueue(reqOutPort, CHIRequestMsg, request_latency) {
    prepareRequest(tbe, CHIRequestType:DvmOpSync, out_msg);
    DPRINTF(RubyProtocol, "Sending DvmOpSync to %d\n", getMiscNodeMachine());

    out_msg.usesTxnId := true;
    out_msg.txnId := tbe.addr; // for DVM TBEs addr = txnId

    out_msg.Destination.clear();
    out_msg.Destination.add(getMiscNodeMachine());
    out_msg.dataToFwdRequestor := false;

    // Don't set message size, we don't use the data inside the messages

    allowRequestRetry(tbe, out_msg);
  }

  clearExpectedReqResp(tbe);
  tbe.expected_req_resp.addExpectedRespType(CHIResponseType:DBIDResp);
  tbe.expected_req_resp.addExpectedCount(1);
  // Comp will be expected later
}

action(Send_DvmTlbi_NCBWrData, desc="") {
  enqueue(datOutPort, CHIDataMsg, data_latency) {
    out_msg.addr := tbe.addr;
    out_msg.type := CHIDataType:NCBWrData;

    out_msg.usesTxnId := true;
    out_msg.txnId := tbe.addr; // for DVM TBEs addr = txnId

    // Set dataBlk to all 0 - we don't actually use the contents
    out_msg.dataBlk.clear();
    // Data should be 8 bytes - this function is (offset, range)
    out_msg.bitMask.setMask(0, 8);

    out_msg.responder := machineID;

    out_msg.Destination.clear();
    out_msg.Destination.add(getMiscNodeMachine());
  }
}

action(Send_DvmSync_NCBWrData, desc="") {
  enqueue(datOutPort, CHIDataMsg, data_latency) {
    out_msg.addr := tbe.addr;
    out_msg.type := CHIDataType:NCBWrData;

    out_msg.usesTxnId := true;
    out_msg.txnId := tbe.addr; // for DVM TBEs addr = txnId

    // Set dataBlk to all 0 - we don't actually use the contents
    out_msg.dataBlk.clear();
    // Data should be 8 bytes - this function is (offset, range)
    // I assume the range is in bytes...
    out_msg.bitMask.setMask(0, 8);

    out_msg.responder := machineID;

    out_msg.Destination.clear();
    out_msg.Destination.add(getMiscNodeMachine());
  }
}

action(DvmTlbi_CompCallback, desc="") {
  assert(is_valid(tbe));
  assert(tbe.is_dvm_tbe);
  assert(tbe.reqType == CHIRequestType:DvmTlbi_Initiate);
  sequencer.unaddressedCallback(tbe.addr, RubyRequestType:TLBI);
}

action(DvmSync_CompCallback, desc="") {
  assert(is_valid(tbe));
  assert(tbe.is_dvm_tbe);
  assert(tbe.reqType == CHIRequestType:DvmSync_Initiate);
  sequencer.unaddressedCallback(tbe.addr, RubyRequestType:TLBI_SYNC);
}

//////////////////////////////////
// DVM Snoop Actions

action(Initiate_DvmSnoop, desc="") {
  // DvmSnoop cannot be retried
  bool was_retried := false;
  peek(snpRdyPort, CHIRequestMsg) {
    set_tbe(allocateDvmSnoopTBE(address, in_msg));
  }
  // Last argument = false, so it uses a "unique ID" rather than an address
  // "Incoming" transactions for DVM = time between receiving a Snooped DVM op
  // and sending the SnpResp_I
  incomingTransactionStart(address, curTransitionEvent(), State:I, was_retried, false);
}

action(DvmExtTlbi_EnqueueSnpResp, desc=""){
  tbe.delayNextAction := curTick() + cyclesToTicks(dvm_ext_tlbi_latency);
  tbe.actions.push(Event:SendSnpIResp);
}

action(DvmExtSync_TriggerCallback, desc=""){
  assert(is_valid(tbe));
  assert(tbe.is_dvm_snp_tbe);
  sequencer.unaddressedCallback(tbe.addr, RubyRequestType:TLBI_EXT_SYNC);
}

action(Profile_OutgoingStart_DVM, desc="") {
  outgoingTransactionStart(address, curTransitionEvent(), false);
}

action(Profile_OutgoingEnd_DVM, desc="") {
  assert(is_valid(tbe));
  outgoingTransactionEnd(address, tbe.rcvdRetryAck, false);
}

// MYSTUFF

action(PostProcess,
       desc="Push one post-processing action: an IDR at the Gather Unit, or StashAndPostEvict above it")
{
    if (gather_unit && hasDependentWork(address)) {
        if (isConsideredEvict(tbe.reqType) && (tbe.dataValid == false)) {
            // A dataless Evict carried the DAG and this Gather Unit holds
            // no copy: a non-inclusive Gather Unit, not supported yet.
            error("Gather Unit: a dataless Evict carried an index DAG but the line is not here");
        }
        // The transaction's initiator fetched the line when this Gather
        // Unit had no current copy (Initiate_FetchIndexLine_*), so the
        // data is here by now. One IDR per DAG descriptor, unless
        // idr_coalesce merges those to one data line. Two IDRs to the
        // same data line are two Loads at the Indirect Unit; the second
        // stalls there and hits.
        assert(tbe.dataValid);
        speculateLine(address, tbe.dataBlk, hov_spec_mode, hov_spec_writes,
                      hov_spec_lines, hov_spec_window);
        if (idr_coalesce) {
            coalesceExtensions(address, tbe.dataBlk);
        }
        tbe.actions.pushNB(Event:TriageIDR);
    } else {
        State toBeState := makeFinalState(tbe, getCacheEntry(address), getDirEntry(address));
        if (idxLineAboveGU(tbe, toBeState) && (tbe.postEvictSent == false)) {
            tbe.actions.push(Event:StashAndPostEvict);
        }
    }
}

// The Gather Unit sends the IDRs of an index request as soon as its data
// goes to the Indirect Unit (SendCompData), not after the transaction's
// CompAck, fill and tag write (PostProcess), so that an IDR reaches the
// Indirect Unit about when the index does and before uop1 misses there.
// PostProcess still sends what this does not reach: the IDRs of a
// notification (answered with NotifAck) or of a post-evict write-back.
action(ScheduleIDRs, desc="Gather Unit: send the IDRs once the index data leaves")
{
    if (gather_unit && hasDependentWork(address)) {
        assert(tbe.dataValid);
        speculateLine(address, tbe.dataBlk, hov_spec_mode, hov_spec_writes,
                      hov_spec_lines, hov_spec_window);
        if (idr_coalesce) {
            coalesceExtensions(address, tbe.dataBlk);
        }
        tbe.actions.pushFrontNB(Event:TriageIDR);
    }
}

// The target flow (3a): the index data of an ldind/stind names the data
// block its own access will bring to the Indirect Unit, so the Indirect
// Unit can wait for it. Runs in the SendCompData transition, after
// ScheduleIDRs and before TX_Data builds the message. Only the line's
// first real entry gets one, and only when it will be injected (mapped,
// and not coalesced away); hovMarkExpect keeps TriageIDR from dropping it.
action(Hov_AttachExpect, desc="Gather Unit: name the data block to expect on the index data")
{
    if (gather_unit && hasDependentWork(address) &&
        (isInvalid(tbe.indirect_unit_id) == false) &&
        (tbe.requestor == tbe.indirect_unit_id)) {
        assert(tbe.dataValid);
        if (hovMarkExpect(address, tbe.dataBlk, idr_coalesce)) {
            tbe.hov_expect_pending := true;
            tbe.hov_expect_addr := hovExpectAddr(address);
            tbe.hov_expect_unique := hovExpectWrite(address) || hov_fetch_unique;
            tbe.hov_expect_name := hovExpectName(address);
        }
    }
}

// The IDRs of an index line go one at a time, in two steps, so that only
// injecting needs a tracker slot: SLICC checks a transition's resources
// before any of its actions run, so a full tracker would stall even an
// IDR that is then dropped. TriageIDR drops the next IDR or passes it to
// IssueIDR, and IssueIDR (which needs a tracker slot and a TBE) injects
// it; either pushes the next TriageIDR at once (a non-blocking trigger)
// while work remains.
action(TriageIDR,
       desc="Gather Unit: drop the next IDR, or pass it to IssueIDR")
{
    assert(gather_unit);
    assert(hasDependentWork(address));
    // Never build an IDR from index data that is not in the TBE
    // (copyCacheAndDir leaves it out in UC_RU/UD_RU).
    assert(tbe.dataValid);

    bool issue := false;
    // A wrong-path uop0 past the end of its pair (or a speculated element
    // past it) reads a garbage index whose data address can lie outside
    // memory. Drop such an IDR, as hardware drops a speculative access to
    // an unmapped address.
    Addr next_addr := peekDependentAddr(address, tbe.dataBlk);
    bool is_spec := peekDependentIsSpec(address);
    if (isMappedDownstream(makeLineAddress(next_addr)) == false) {
        // Hov_AttachExpect never names an unmapped block
        assert(peekDependentHasExpect(address) == false);
        DPRINTF(IndirectAccess,
            "IDR from index line %#x to unmapped address %#x dropped.\n",
            address, next_addr);
        dropDependentReq(address);
        countIdrDroppedUnmapped();
        if (is_spec) {
            countSpecIdr(1);
        }
    } else if (idr_coalesce && (peekDependentHasExpect(address) == false) &&
               (idrVerdict(makeLineAddress(next_addr),
                           peekDependentIsWrite(address)) != 0)) {
        // Coalescing across index lines: an IDR to a data line with one
        // in flight or sent recently is dropped. An IDR whose block the
        // Indirect Unit expects is always injected.
        DPRINTF(IndirectAccess,
            "IDR from index line %#x to data line %#x dropped: one is in flight or recent.\n",
            address, makeLineAddress(next_addr));
        dropDependentReq(address);
        if (is_spec) {
            countSpecIdr(2);
        }
    } else {
        issue := true;
    }
    if (issue) {
        tbe.actions.pushFrontNB(Event:IssueIDR);
    } else if (hasDependentWork(address)) {
        tbe.actions.pushFrontNB(Event:TriageIDR);
    }
}

// The target flow (3b): the Gather Unit injects an ordinary ReadShared
// (ReadUnique for a write, or under hov_fetch_unique) into its own request
// path with the Indirect Unit as requestor; the line's own transitions
// decide whether to send anything (reqRdyPort: nothing when the directory
// lists the Indirect Unit as holding the block), fetch it from the Value
// Unit, and deliver CompData to the Indirect Unit. The request holds a
// tracker slot until its transaction ends (Finalize_DeallocateRequest).
action(IssueIDR,
       desc="Gather Unit: inject the IDR TriageIDR passed (needs a tracker slot and a TBE)")
{
    assert(gather_unit);
    assert(hasDependentWork(address));
    assert(tbe.dataValid);

    // Resource stall while the tracker is full, or while no TBE is free
    // for the injected request's own transaction.
    check_allocate(storHovTBEs);
    check_allocate(storTBEs);

    if (isInvalid(tbe.indirect_unit_id)) {
        // The DAG came by a path with no Indirect Unit on it: no target
        assert(peekDependentHasExpect(address) == false);
        DPRINTF(IndirectAccess,
            "IDR from index line %#x dropped: no Indirect Unit to deliver to.\n",
            address);
        dropDependentReq(address);
        countHovFwd(4);
    } else {
        bool is_spec := peekDependentIsSpec(address);
        bool has_expect := peekDependentHasExpect(address);
        bool is_write := peekDependentIsWrite(address);
        RequestPtr depReq := getDependentReq(address, tbe.dataBlk);
        Addr acc_addr := getAddr(depReq);
        Addr data_line := makeLineAddress(acc_addr);
        bool unique := (isDepReadReq(depReq) == false) || hov_fetch_unique;

        int hov_slot := storHovTBEs.addEntryToNewSlot();
        storTBEs.incrementReserved();
        hovTrackerOpen(hov_slot, data_line, unique, is_spec, has_expect);
        if (is_spec) {
            countSpecIdr(0);
        }
        if (idr_coalesce) {
            noteIdrSent(data_line, static_cast(Addr, "value", hov_slot),
                        is_write, idr_recent_lines);
        }

        enqueue(reqRdyOutPort, CHIRequestMsg, allocation_latency) {
            out_msg.addr := data_line;
            out_msg.accAddr := acc_addr;
            out_msg.accSize := getSize(depReq);
            if (unique) {
                out_msg.type := CHIRequestType:ReadUnique;
            } else {
                out_msg.type := CHIRequestType:ReadShared;
            }
            if (isDepReadReq(depReq)) {
                out_msg.secondType := CHIRequestType:ReadValue;
            } else {
                out_msg.secondType := CHIRequestType:WriteValue;
            }
            out_msg.requestor := tbe.indirect_unit_id;
            out_msg.fwdRequestor := tbe.indirect_unit_id;
            out_msg.dataToFwdRequestor := false;
            out_msg.retToSrc := false;
            // The TBE is reserved here: the request is never retried
            out_msg.allowRetry := false;
            out_msg.Destination.add(machineID);
            out_msg.seqReq := depReq;
            out_msg.isSeqReqValid := true;
            out_msg.is_local_pf := false;
            out_msg.is_remote_pf := false;
            out_msg.txnId := static_cast(Addr, "value", hov_slot);
            out_msg.ns := tbe.ns;
            // hov<p>_data, as uop1 names the same access
            out_msg.access_name := getReqAccessName(depReq);
            out_msg.alias := getIndirectAlias(depReq);
            out_msg.indirect_unit_id := tbe.indirect_unit_id;
            out_msg.value_unit_id := tbe.value_unit_id;
            out_msg.gather_unit_id := tbe.gather_unit_id;
            out_msg.hov_spec := is_spec;
            out_msg.hov_fwd := true;
            out_msg.hov_slot := hov_slot;
            // hov_lane_mask and hov_reg_id stay 0: the scalar form (the
            // vector form sets the register's lanes in this block)

            DPRINTF(IndirectAccess,
                "3b: index_line=%#x -> inject %s for data line %#x (acc %#x) on behalf of %s, slot %d, alias=%#x spec=%d expect=%d\n",
                address, out_msg.type, data_line, acc_addr,
                tbe.indirect_unit_id, hov_slot, out_msg.alias, is_spec,
                has_expect);
        }
    }
    // The line's next IDR follows at once (a non-blocking trigger), whether
    // ScheduleIDRs or PostProcess pushed the first.
    if (hasDependentWork(address)) {
        tbe.actions.pushFrontNB(Event:TriageIDR);
    }
}

// A cache above the Gather Unit that holds an index line never forwards a
// DAG for it: the DAG is stashed per line (merged with any DAG already
// there) and the delayed post-evict replacement writes the line back with
// the stash in its seqReq (Initiate_Replacement), so the Gather Unit gets
// the DAG and the current index data in one transaction.
action(StashAndPostEvict,
       desc="Stash the DAG for the index line and schedule its post-evict once")
{
    assert(isInvalid(tbe.gather_unit_id));
    tbe.postEvictSent := true;
    if (tbe.isSeqReqValid && hasDAG(tbe.seqReq)) {
        stashPostEvictDAG(address, tbe.seqReq);
    }
    if (isReplEnqueued(address) == false) {
        markReplEnqueued(address);
        // replTriggerQueue is strict FIFO and ordinary replacements enqueue
        // with no delay, so a replacement enqueued within post_evict_delay
        // after this message would arrive before it and violate the order.
        // This delayed message bypasses the strict-FIFO check: if an
        // ordinary replacement evicts the same line first, it takes the
        // stash and the post-evict finds the line in I and is dropped
        // (transition I, Local_Eviction).
        enqueue(replTriggerOutPort, ReplacementMsg, post_evict_delay, true) {
            out_msg.addr := address;
            out_msg.from_addr := address;
            out_msg.post_evict := true;
        }
    } else {
        DPRINTF(IndirectAccess, "Post-evict of %#lx already scheduled; DAG merged into the stash.\n", address);
    }
}

action(ClearReplEnqueued,
       desc="A replacement popped without acting (UD_T): keep the stash, let the next DAG re-schedule the post-evict")
{
    clearReplEnqueued(address);
}

// Gather Unit: a notification (UpdateDAG) brought DAGs for a line whose
// current data is not here. The state says where it is: an upstream cache
// holds a copy (UC_RU, UD_RU, RU, RSC, RSD, RUSC, RUSD), which is snooped
// as Initiate_ReadOnce_HitUpstream does, or nobody above does (I), and the
// line is read from downstream as Initiate_LoadMiss does. PostProcess
// sends the IDRs once the data has arrived.
action(Initiate_FetchIndexLine_Upstream,
       desc="Gather Unit: snoop the upstream copy of the index line before the IDRs")
{
    assert(gather_unit);
    assert(tbe.dataValid == false);
    assert(tbe.dir_sharers.count() > 0);
    tbe.actions.push(Event:ReadMissPipe);
    tbe.actions.push(Event:SendSnpOnce);
    if (is_invalid(cache_entry)) {
        // no entry here: the snooped data is dropped at the end
        tbe.dataToBeInvalid := true;
    }
    DPRINTF(IndirectAccess, "Gather Unit fetches index line %#x from upstream.\n", address);
}

action(Initiate_FetchIndexLine_Downstream,
       desc="Gather Unit: read the absent index line from downstream before the IDRs")
{
    assert(gather_unit);
    assert(tbe.dataValid == false);
    assert(is_invalid(cache_entry));
    tbe.actions.push(Event:ReadMissPipe);
    if (tbe.doCacheFill) {
        tbe.actions.push(Event:SendReadShared);
        tbe.actions.push(Event:CheckCacheFill);
        tbe.actions.push(Event:TagArrayWrite);
    } else {
        tbe.actions.push(Event:SendReadOnce);
        tbe.dataToBeInvalid := true;
    }
    DPRINTF(IndirectAccess, "Gather Unit fetches index line %#x from downstream (fill=%d).\n", address, tbe.doCacheFill);
}

action(Extract_Extensions, desc="") {
    // NOTE: We may want to remove this assertion and put the
    // entire functionality inside an if statement.
    assert(gather_unit);
    assert(tbe.isSeqReqValid && hasDAG(tbe.seqReq));
    // MYSTUFF: count the DAG's descriptors by carrier: an index request,
    // a notification, or a post-evict write-back
    if (tbe.reqType == CHIRequestType:NotifyIndIdx) {
      countDAGCarrier(1, tbe.seqReq);
    } else if (isPropagateEvict(tbe.reqType, tbe.secondType)) {
      countDAGCarrier(2, tbe.seqReq);
    } else {
      countDAGCarrier(0, tbe.seqReq);
    }
    // FFUTSYM
    extractExtensions(tbe.addr, tbe.seqReq, tbe.dataBlk);
}

// Forward a notification downstream (this cache does not hold the line).
action(Send_NotifyIndIdx) {
    enqueue(reqOutPort, CHIRequestMsg, request_latency) {
        prepareRequest(tbe, CHIRequestType:NotifyIndIdx, out_msg);
        out_msg.Destination.clear();
        out_msg.Destination.add(mapAddressToDownstreamMachine(out_msg.addr));
        // Arm the TBE as well as the message, so a RetryAck can be served.
        allowRequestRetry(tbe, out_msg);
    }
    // Wait for NotifAck from downstream before finalizing
    tbe.expected_req_resp.addExpectedRespType(CHIResponseType:NotifAck);
    tbe.expected_req_resp.addExpectedCount(1);
}

action(Send_NotifAck, desc="Send NotifAck back to requestor for NotifyIndIdx") {
    // Don't ack self — the originator (from sequencer) has no upstream to ack
    if (tbe.requestor != machineID) {
        enqueue(rspOutPort, CHIResponseMsg, response_latency) {
            out_msg.addr := address;
            out_msg.type := CHIResponseType:NotifAck;
            out_msg.responder := machineID;
            out_msg.Destination.add(tbe.requestor);
            out_msg.txnId := tbe.txnId;
        }
    }
}

////////////////////////////////////////////////////////////////////////////
// The target flow (docs/agents/2026-10-25-wp0/PLAN.md)

// Gather Unit, reqRdyPort: an injected request for a block the directory
// lists the Indirect Unit as holding. Send nothing, as CHI's directory
// does for a requester that holds the block; free the slot and the TBE
// reservation IssueIDR made.
action(Hov_FwdHeld, desc="Gather Unit: drop an injected request for a block the Indirect Unit holds") {
  assert(gather_unit);
  assert(is_invalid(tbe));
  peek(reqRdyPort, CHIRequestMsg) {
    assert(in_msg.hov_fwd);
    DPRINTF(IndirectAccess,
        "3b: injected %s for %#x not sent: %s holds the block (slot %d).\n",
        in_msg.type, address, in_msg.requestor, in_msg.hov_slot);
    storHovTBEs.removeEntryFromSlot(in_msg.hov_slot);
    hovTrackerClose(in_msg.hov_slot, 2, idr_coalesce);
  }
  storTBEs.decrementReserved();
  processRetryQueue();
}

// Indirect Unit: the index data names a data block to expect (3a). Queue
// it for that line on reqRdy, with a TBE reserved for it; with no TBE free,
// the expect is dropped (the delivery is then taken on arrival).
action(Hov_RecvExpect, desc="Indirect Unit: queue the expect the index data carries") {
  if (indirect_unit) {
    peek(datInPort, CHIDataMsg) {
      if (in_msg.hov_expect) {
        if (storTBEs.areNSlotsAvailable(1)) {
          storTBEs.incrementReserved();
          enqueue(reqRdyOutPort, CHIRequestMsg, allocation_latency) {
            out_msg.addr := in_msg.hov_expect_addr;
            out_msg.accAddr := in_msg.hov_expect_addr;
            out_msg.accSize := blockSize;
            out_msg.type := CHIRequestType:HovExpect;
            if (in_msg.hov_expect_unique) {
              out_msg.secondType := CHIRequestType:WriteValue;
            } else {
              out_msg.secondType := CHIRequestType:ReadValue;
            }
            out_msg.requestor := in_msg.responder;
            out_msg.fwdRequestor := in_msg.responder;
            out_msg.allowRetry := false;
            out_msg.Destination.add(machineID);
            out_msg.isSeqReqValid := false;
            out_msg.is_local_pf := false;
            out_msg.is_remote_pf := false;
            out_msg.txnId := in_msg.txnId;
            out_msg.access_name := in_msg.hov_access_name;
          }
          DPRINTF(IndirectAccess,
              "3a: index data %#x names data block %#x (unique %d); expect queued.\n",
              address, in_msg.hov_expect_addr, in_msg.hov_expect_unique);
        } else {
          DPRINTF(IndirectAccess,
              "3a: expect for %#x dropped: no TBE free.\n", in_msg.hov_expect_addr);
          countHovExpect(2);
        }
      }
    }
  }
}

// Indirect Unit: wait for the expected block in a TBE shaped as a load
// miss whose ReadShared someone else sent, so the delivery completes it
// through the stock CompData transitions and the core's own access to the
// line stalls on it.
action(Initiate_HovExpect, desc="Indirect Unit: allocate a TBE that waits for the expected block") {
  assert(indirect_unit);
  State initial := getState(tbe, cache_entry, address);
  peek(reqRdyPort, CHIRequestMsg) {
    storTBEs.decrementReserved();
    set_tbe(allocateHovRecvTBE(address, in_msg.requestor,
                               in_msg.secondType == CHIRequestType:WriteValue,
                               in_msg.access_name));
  }
  hovSetupRecvTBE(tbe, cache_entry, initial, 1);
  if (hovExpectTimers.isSet(address)) {
    hovExpectTimers.unset(address);
  }
  if (hov_expect_timeout > intToCycles(0)) {
    hovExpectTimers.set(address,
                        clockEdge() + cyclesToTicks(hov_expect_timeout));
  }
  countHovExpect(0);
  DPRINTF(IndirectAccess, "3a: waiting for data block %#x.\n", address);
  incomingTransactionStart(address, curTransitionEvent(), initial, false);
}

// Indirect Unit: the expected block is here already
action(Hov_ExpectPresent, desc="Indirect Unit: an expect for a block that is here") {
  assert(is_invalid(tbe));
  storTBEs.decrementReserved();
  if (hovTakeDeliveredNoExpect(address)) {
    countHovExpect(3);
  } else {
    countHovExpect(1);
  }
}

// Indirect Unit: the line is busy (a delivery taken on arrival, or the
// core's own access): the expect is not needed or cannot wait
action(Hov_ExpectBusy, desc="Indirect Unit: an expect for a line with a transaction") {
  assert(is_valid(tbe));
  storTBEs.decrementReserved();
  if ((tbe.hov_recv == 2) || hovTakeDeliveredNoExpect(address)) {
    countHovExpect(3);
  } else {
    countHovExpect(4);
  }
}

// Indirect Unit: a delivered block (5) no TBE waits for. Take it in a TBE
// allocated on arrival, shaped as Initiate_HovExpect's; the transition
// then receives the data as the stock CompData transitions do.
action(Initiate_HovDeliver, desc="Indirect Unit: allocate a TBE for a delivered block") {
  assert(indirect_unit);
  State initial := getState(tbe, cache_entry, address);
  peek(datInPort, CHIDataMsg) {
    set_tbe(allocateHovRecvTBE(address, in_msg.responder, false,
                               in_msg.hov_access_name));
    tbe.hov_lane_mask := in_msg.hov_lane_mask;
    tbe.hov_reg_id := in_msg.hov_reg_id;
  }
  hovSetupRecvTBE(tbe, cache_entry, initial, 2);
  hovNoteDeliveredNoExpect(address);
  countHovDeliver(1);
  DPRINTF(IndirectAccess, "5: data block %#x delivered with no TBE waiting; taken on arrival.\n", address);
  incomingTransactionStart(address, curTransitionEvent(), initial, false);
}

// Indirect Unit, stock CompData transition: count a delivery the TBE of
// its expect takes
action(Hov_CountDelivery, desc="Indirect Unit: count a delivery its expect takes") {
  if (indirect_unit) {
    peek(datInPort, CHIDataMsg) {
      if (in_msg.hov_fwd && (tbe.hov_recv == 1) &&
          (tbe.dataBlkValid.count() == 0)) {
        countHovDeliver(0);
        DPRINTF(IndirectAccess, "5: data block %#x delivered into its expect.\n", address);
      }
    }
  }
}

// Indirect Unit: a delivered block it cannot take (the line is here, or
// busy with a transaction of its own, such as the core's own miss, which
// sees its own request through; or no TBE is free). Acknowledge it as
// declined so the Gather Unit keeps the block and leaves its directory as
// it was, and drop the data. Never recycled: the Gather Unit's transaction
// waits for this CompAck.
action(Hov_Decline, desc="Indirect Unit: decline a delivered block") {
  peek(datInPort, CHIDataMsg) {
    assert(in_msg.hov_fwd);
    enqueue(rspOutPort, CHIResponseMsg, response_latency) {
      out_msg.addr := address;
      out_msg.type := CHIResponseType:CompAck;
      out_msg.responder := machineID;
      out_msg.Destination.add(in_msg.responder);
      out_msg.txnId := in_msg.txnId;
      out_msg.hov_declined := true;
    }
    hovDeclineBegin(address, (blockSize / data_channel_size) - 1);
  }
  countHovDeliver(2);
  DPRINTF(IndirectAccess, "5: data block %#x delivered but declined.\n", address);
}

action(Hov_DeclineCont, desc="Indirect Unit: drop a later chunk of a declined delivery") {
  hovDeclineChunk(address);
}

// Indirect Unit: a TBE waiting for an expected block gives up after
// hov_expect_timeout cycles (the block was not sent: the Gather Unit's
// directory said this cache held it). It ends with no data; the core's
// access then misses as it would have without the expect.
action(Hov_ExpectTimeout, desc="Indirect Unit: give up waiting for an expected block") {
  if (is_valid(tbe) && tbe.is_snp_tbe) {
    // A snoop is being handled on the line: look again later
    hovExpectTimers.unset(address);
    hovExpectTimers.set(address,
                        clockEdge() + cyclesToTicks(intToCycles(100)));
  } else {
    hovExpectTimers.unset(address);
    if (is_valid(tbe) && tbe.is_req_tbe && (tbe.hov_recv == 1) &&
        tbe.expected_req_resp.hasExpected() &&
        (tbe.expected_req_resp.hasReceivedData() == false) &&
        (tbe.dataBlkValid.count() == 0)) {
      DPRINTF(IndirectAccess, "3a: expect for %#x timed out.\n", address);
      clearExpectedReqResp(tbe);
      tbe.dataToBeInvalid := true;
      countHovExpect(5);
      // nothing is expected now: run the queued fill check and finish
      processNextState(address, tbe, cache_entry);
    }
  }
}

action(Hov_ExpectTimeoutStale, desc="Indirect Unit: a timer whose TBE is gone") {
  hovExpectTimers.unset(address);
}
// FFUTSYM
